# Copie este arquivo para ".env" antes de subir o docker-compose.
# (o docker-compose.yml le automaticamente um arquivo ".env" na mesma pasta)

# UID do usuario do host -- evita problemas de permissao nos volumes montados
# em ./airflow/logs e ./data. No Linux/Mac, rode `id -u` no terminal e cole
# o numero aqui. No Windows (Docker Desktop) pode manter 50000.
AIRFLOW_UID=50000

# Limita a quantidade de linhas lidas dos CSVs brutos (util para testes
# rapidos locais). Deixe vazio para ler o dataset completo.
NUM_ROWS=

# Numero de folds do K-Fold em train.py (pode reduzir para 3 em testes locais)
NUM_FOLDS=3
